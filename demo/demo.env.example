# Copy to demo/demo.env (not committed) and fill the key and the access code.

# OpenRouter key: https://openrouter.ai/keys  (set a monthly limit on the key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# models shown to visitors, and the one the server uses on its own
OPENROUTER_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro
DEFAULT_MODEL=openrouter:deepseek/deepseek-v4-flash

# visitors must enter this before using the demo:  openssl rand -hex 6
ACCESS_CODE=

# used by docker compose itself (port for checks on the server, website network)
DEMO_PORT=3500
SITE_NETWORK=greenlanco_internal
